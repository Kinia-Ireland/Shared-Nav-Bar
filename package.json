{
  "name": "kinia-shared-nav-bar",
  "version": "1.0.0",
  "description": "The shared Kinia top bar (language toggle, notifications, account menu, app launcher) for every Kinia web app.",
  "private": true,
  "type": "module",
  "main": "./dist/kinia-shared-nav-bar.js",
  "module": "./dist/kinia-shared-nav-bar.js",
  "exports": {
